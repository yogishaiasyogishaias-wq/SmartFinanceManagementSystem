{
  "name": "smart-finance-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Smart Finance Management System monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "web": "npm run dev --workspace=@smart-finance/web",
    "mobile": "npm run start --workspace=@smart-finance/mobile"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
